{
  "info": {
    "_postman_id": "6c33a8cc-9026-4c8a-9d3a-4c8b0ea219e1",
    "name": "SANE+ API (CI Local)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (!pm.environment.get('baseUrl')) {",
          "  throw new Error('baseUrl não definido');",
          "}",
          "if (!pm.environment.get('password')) {",
          "  pm.environment.set('password', 'Pass123!');",
          "}",
          "if (!pm.environment.get('email')) {",
          "  pm.environment.set('email', 'citizen_' + Date.now() + '@test.local');",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "item": [
    {
      "name": "Auth • Me (unauth)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', () => pm.expect(pm.response.code).to.eql(401));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Auth • Register (creates session cookie)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "content-type",
            "value": "application/json"
          },
          {
            "key": "accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Tester\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.expect(pm.response.code).to.eql(200));",
              "const json = pm.response.json();",
              "pm.test('ok true', () => pm.expect(json.ok).to.eql(true));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Auth • Me (authenticated)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.expect(pm.response.code).to.eql(200));",
              "const json = pm.response.json();",
              "pm.test('tem id/email/role', () => {",
              "  pm.expect(json).to.have.property('id');",
              "  pm.expect(json).to.have.property('email');",
              "  pm.expect(json).to.have.property('role');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Complaints • Create (valid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "content-type",
            "value": "application/json"
          },
          {
            "key": "accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"companyName\": \"Companhia Teste\",\n  \"category\": \"Água\",\n  \"issue\": \"Falta de água\",\n  \"description\": \"Sem água há 2 dias.\",\n  \"visibility\": \"PUBLIC\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/complaints",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "complaints"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.expect(pm.response.code).to.eql(200));",
              "const json = pm.response.json();",
              "pm.test('retorna id', () => pm.expect(json).to.have.property('id'));",
              "pm.environment.set('complaintId', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Complaints • List (authenticated)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/complaints",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "complaints"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.expect(pm.response.code).to.eql(200));",
              "const items = pm.response.json();",
              "pm.test('lista contém complaintId', () => {",
              "  const id = pm.environment.get('complaintId');",
              "  pm.expect(items.map(i => i.id)).to.include(id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Complaints • Create (XSS blocked)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "content-type",
            "value": "application/json"
          },
          {
            "key": "accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"companyName\": \"Companhia Teste\",\n  \"category\": \"Água\",\n  \"issue\": \"Falta de água\",\n  \"description\": \"<img src=x onerror=alert(1)>\",\n  \"visibility\": \"PUBLIC\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/complaints",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "complaints"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 400', () => pm.expect(pm.response.code).to.eql(400));",
              "const json = pm.response.json();",
              "pm.test('tem erro', () => pm.expect(json).to.have.property('error'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Auth • Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.expect(pm.response.code).to.eql(200));",
              "const json = pm.response.json();",
              "pm.test('ok true', () => pm.expect(json.ok).to.eql(true));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Auth • Me (after logout)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', () => pm.expect(pm.response.code).to.eql(401));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}

